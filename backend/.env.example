# Copy this file to .env and fill in real values. Never commit .env itself.

# Fill in with YOUR local Postgres URL, e.g. postgresql://postgres:devpass@localhost:5432/sellince
DATABASE_URL=
# Set a long random string, e.g. openssl rand -hex 32
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Admin = 5174, customer = 5173, legacy/other = 3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
COOKIE_SECURE=False
# Set COOKIE_SECURE=True in production (HTTPS required) so the refresh-token cookie is only sent over https
COOKIE_SAMESITE=lax
SQL_ECHO=False
# Optional: without it the AI agent falls back to rule-based replies
GROQ_API_KEY=

# Optional overrides; defaults live in app/rag/config.py
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
