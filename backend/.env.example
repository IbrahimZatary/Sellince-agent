# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql://postgres:devpass@localhost:5432/sellince
JWT_SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=False
# Set COOKIE_SECURE=True in production (HTTPS required) so the refresh-token cookie is only sent over https
COOKIE_SAMESITE=lax
SQL_ECHO=False
